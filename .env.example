# ── Supabase ─────────────────────────────────────────────────────────────
# Browser-safe values (NEXT_PUBLIC_ only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by the cron job, the
# WhatsApp webhook and scripts/create-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (all SERVER ONLY) ─────────────────────────────────
WHATSAPP_ACCESS_TOKEN=            # permanent System User token (not the 24h test token) in production
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v23.0      # check Meta's changelog for the current version
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any long random string; paste the same value into the Meta webhook config
WHATSAPP_APP_SECRET=              # Meta App secret; used to verify X-Hub-Signature-256
WHATSAPP_TEMPLATE_LANGUAGE=en     # must match the approved template language code
# Test sends from Settings are always on in development; set to "true" to allow them in production.
WHATSAPP_ALLOW_TEST_SEND=

# ── Scheduler ────────────────────────────────────────────────────────────
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
APP_TIMEZONE=Asia/Kolkata
